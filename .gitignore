**/sessions/
**/history/
**/blobs/
**/browser-profiles/
**/state/
**/backups/
**/node_modules/
**/venv/
**/.venv/
**/__pycache__/
**/*.exe
**/*.dll
**/*.whl
**/*.zip
**/*.tgz
**/*.tar.gz
